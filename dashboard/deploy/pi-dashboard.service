# systemd unit for the dashboard stats server.
# Install:
#   sudo cp dashboard/deploy/pi-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pi-dashboard
[Unit]
Description=Pi command center dashboard
After=network.target

[Service]
User=mason
WorkingDirectory=/home/mason/Desktop/Personal
ExecStart=/usr/bin/env node dashboard/server/server.mjs
Environment=HOST=127.0.0.1 PORT=8787
Restart=on-failure

[Install]
WantedBy=multi-user.target
